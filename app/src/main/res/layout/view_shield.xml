<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/shieldRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/shield_bg_light"
    android:clickable="true"
    android:focusable="false"
    android:gravity="center"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp">

        <ImageView
            android:id="@+id/shieldArt"
            android:layout_width="220dp"
            android:layout_height="164dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@drawable/shield_art_light" />

        <TextView
            android:id="@+id/shieldTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:letterSpacing="0.01"
            android:text="@string/shield_title"
            android:textColor="@color/shield_text_light"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/shieldSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="@string/shield_sub"
            android:textColor="@color/shield_sub_light"
            android:textSize="14sp" />

        <View
            android:id="@+id/shieldDivider"
            android:layout_width="40dp"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:background="@color/shield_line_light" />

        <TextView
            android:id="@+id/shieldFoot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="@string/shield_foot"
            android:textColor="@color/shield_foot_light"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
